# ===================================================================
# HFT Trading System - 환경변수 설정
# ===================================================================
# 이 파일은 환경변수 템플릿입니다.
# .env 파일을 생성하여 실제 값을 입력하세요.
#
# 사용법:
#   1. 이 파일을 복사: cp .env.example .env
#   2. .env 파일에서 실제 API 키 및 계정 정보 입력
#   3. .env 파일은 절대 Git에 커밋하지 마세요! (.gitignore에 포함됨)
# ===================================================================

# ===== 한국투자증권 KIS API 인증 정보 =====
# https://apiportal.koreainvestment.com 에서 발급받으세요

# 앱 키 (App Key)
# KIS API 포털에서 발급받은 앱 키를 입력하세요
# 예: KIS_APP_KEY=PSabcdefg1234567890hijklmnopqr
KIS_APP_KEY=your_app_key_here

# 앱 시크릿 (App Secret)
# KIS API 포털에서 발급받은 앱 시크릿을 입력하세요
# 주의: 이 값은 절대 외부에 노출되어서는 안 됩니다!
# 예: KIS_APP_SECRET=abcdefghijklmnopqrstuvwxyz1234567890ABCD
KIS_APP_SECRET=your_app_secret_here


# ===== 계좌 정보 =====

# 계좌번호 (Account Number)
# 종합계좌번호 8자리 (앞 8자리만 입력)
# 예: KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_NO=your_account_number_here

# 계좌상품코드 (Account Product Code)
# 보통 "01"이며, 계좌 유형에 따라 다를 수 있습니다
# 01: 종합계좌, 기타는 증권사에 문의하세요
KIS_ACCOUNT_PRODUCT_CODE=01


# ===== 환경 설정 =====

# KIS API 환경 (Environment)
# real: 실전투자 (실제 주식 거래, 실제 돈 사용)
# virtual: 모의투자 (테스트 환경, 가상 계좌)
#
# ⚠️ 중요: 처음에는 반드시 virtual로 설정하여 충분히 테스트하세요!
# 실전투자는 실제 돈이 거래되므로 매우 신중해야 합니다.
KIS_ENV=virtual


# ===== 로깅 설정 =====

# 로그 레벨 (Log Level)
# DEBUG: 모든 로그 출력 (디버깅용, 매우 상세함)
# INFO: 일반 정보 로그 (기본값, 운영 환경 권장)
# WARNING: 경고 이상만 출력
# ERROR: 에러 이상만 출력
# CRITICAL: 치명적인 에러만 출력
LOG_LEVEL=INFO


# ===== 데이터베이스 설정 =====

# 데이터베이스 파일 경로
# SQLite 데이터베이스 파일이 저장될 위치
# 상대 경로 또는 절대 경로 사용 가능
DB_PATH=data/trading.db


# ===================================================================
# 추가 참고사항
# ===================================================================
#
# 1. KIS API 키 발급 방법:
#    - https://apiportal.koreainvestment.com 접속
#    - 회원가입 및 로그인
#    - API 서비스 신청
#    - 앱 키(App Key) 및 앱 시크릿(App Secret) 발급
#
# 2. 모의투자 vs 실전투자:
#    - 모의투자: 가상 계좌로 무료 테스트 (손실 위험 없음)
#    - 실전투자: 실제 계좌로 거래 (실제 돈 사용, 손실 위험 있음)
#    - 반드시 모의투자에서 충분히 테스트 후 실전투자로 전환하세요!
#
# 3. 보안 주의사항:
#    - .env 파일은 절대 Git에 커밋하지 마세요
#    - API 키와 시크릿은 타인과 공유하지 마세요
#    - 깃허브 등 공개 저장소에 업로드하지 마세요
#    - .gitignore에 .env가 포함되어 있는지 확인하세요
#
# 4. 문제 해결:
#    - API 연결 실패: API 키와 시크릿이 정확한지 확인
#    - 환경변수 로드 안됨: .env 파일 위치 확인 (프로젝트 루트)
#    - 인증 오류: KIS_ENV가 올바른지 확인 (real/virtual)
#
# ===================================================================
